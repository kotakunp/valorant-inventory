# Riot Sign On — fill these in when Riot emails your approved client_id
# (Developer Portal → production key → RSO request). Leave empty to keep
# the "Sign in with Riot" button disabled (token-paste mode still works).
RSO_CLIENT_ID=
RSO_REDIRECT_URI=http://localhost:5173/rso/callback
# Only if Riot issues you a confidential client:
RSO_CLIENT_SECRET=

# API server port
PORT=3001

# Optional: CapMonster key enables server-side hcaptcha solve for password
# mode on the hosted site (widget tokens are host-locked to our origin).
# Leave empty → use AUTO LOGIN remote browser or cookie paste.
CAPMONSTER_API_KEY=

# Share links (optional). Postgres connection string, e.g. Supabase session
# pooler. Leave empty to disable sharing in production.
DATABASE_URL=
# 32+ random characters (e.g. `openssl rand -hex 32`). Signs the ownership
# proof that lets a signed-in user create a link. Keep it stable across deploys.
SHARE_SECRET=
# Public origin used in link-preview tags, e.g. https://valorant.muur.app
PUBLIC_URL=
